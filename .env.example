# Database Configuration (PlanetScale)
DB_HOST=your-planetscale-host.mysql-us-east-1.planetscale.tech
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Server Configuration
PORT=3000
NODE_ENV=production

# Admin Panel Authentication - REQUIRED
# Set a strong password here (not natsadmin2026)
ADMIN_SECRET=your_strong_admin_password_here

# PayFast Configuration
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_payfast_passphrase
PAYFAST_RETURN_URL=https://www.rokthenats.co.za/payment-success.html
PAYFAST_CANCEL_URL=https://www.rokthenats.co.za/payment-cancel.html
PAYFAST_NOTIFY_URL=https://www.rokthenats.co.za/api/paymentNotify
